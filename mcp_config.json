{
  "mcpServers": {
    "job-application-flow": {
      "command": "uv",
      "args": [
        "run",
        "--quiet",
        "--script",
        "/path/to/JobApplicationFlow/mcp_server_standalone.py"
      ],
      "env": {
        "OPENAI_API_KEY": "your-openai-api-key-here",
        "SERPER_API_KEY": "your-serper-api-key-here"
      }
    }
  }
}
